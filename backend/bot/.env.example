# TrappistAI Bot Configuration

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# WaveSpeed API (for image/music/3D generation)
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Ollama (local LLM - optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq API (for lyrics generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database
DB_PATH=piranai.db

# Admin
ADMIN_USERNAME=djaf77

# ============================================
# WEBHOOK CONFIGURATION (for TrappistAI integration)
# ============================================

# Secret key for webhook authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=mon_secret_super_securise_12345

# TrappistAI backend URL (for syncing generations)
TRAPPIST_WEBHOOK_URL=https://trappistai-backend.onrender.com/api/telegram/generation
